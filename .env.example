APP_ENV=local

COMPANY=Maple Lane Studio LLC
LEDGER_FILE=data/company.bean
PORT=3001
ACCOUNTING_BASIS=cash
DEBUG_LEDGER_PASSWORD=password
TEST_MODE=false
ALLOW_LEDGER_READ=true

# ---- Supabase (added for multi-tenancy / Phase 0+) ----
# Local values are printed by `bunx supabase status`. They are identical on every
# local Supabase install — published defaults, not secrets.
# Production values come from the cloud project and ARE secrets.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<from `bunx supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<from `bunx supabase status`>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- newgl-ai (internal service) ----
NEWGL_AI_URL=http://127.0.0.1:3002
# Shared secret authenticating newgl-api -> newgl-ai.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=<generate>
